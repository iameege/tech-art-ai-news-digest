{
  "name": "tech-art-ai-news-digest",
  "version": "0.1.0",
  "private": true,
  "description": "LLM research pipeline for Technical Artists, Pipeline TDs and game production — ingests 33 RSS/API sources (Unreal, DCC, VFX, procedural, 3D-AI), enriches them with pluggable LLM backends, ranks by TA-workflow impact, and renders a self-contained HTML digest with i18n and GitHub Actions automation.",
  "keywords": [
    "technical-artist",
    "pipeline-td",
    "llm",
    "llm-pipeline",
    "prompt-engineering",
    "ai-workflow",
    "news-digest",
    "unreal-engine",
    "digital-art",
    "vfx",
    "procedural-content",
    "data-pipeline",
    "automation",
    "typescript",
    "github-actions",
    "rss"
  ],
  "scripts": {
    "dry-run": "tsx scripts/dry-run.ts",
    "daily": "tsx scripts/daily.ts",
    "render": "tsx scripts/render.ts",
    "regen-enrich": "tsx scripts/regen-enrich.ts",
    "quota-report": "tsx scripts/quota-report.ts",
    "sources": "tsx scripts/sources.ts",
    "sources:check": "tsx scripts/sources.ts check",
    "deploy": "node scripts/deploy.mjs",
    "build-site": "node scripts/build-site.mjs",
    "open": "node scripts/open-report.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "cheerio": "^1.2.0",
    "jsonrepair": "^3.14.0",
    "openai": "^6.38.0",
    "resend": "^6.12.4",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv": "^17.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
